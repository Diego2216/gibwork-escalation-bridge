{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodburn.dev/schemas/gibwork-escalation-evidence.schema.json",
  "title": "Gibwork Escalation Submission Evidence",
  "type": "object",
  "required": ["commit", "summary", "tests", "criteriaSatisfied"],
  "properties": {
    "repositoryUrl": {"type": "string", "format": "uri"},
    "patchUrl": {"type": "string", "format": "uri"},
    "commit": {"type": "string", "minLength": 6},
    "summary": {"type": "string", "minLength": 5},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "criteriaSatisfied": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
  },
  "anyOf": [{"required": ["repositoryUrl"]}, {"required": ["patchUrl"]}]
}
