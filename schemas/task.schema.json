{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodburn.dev/schemas/gibwork-escalation-task.schema.json",
  "title": "Gibwork Escalation Task",
  "type": "object",
  "required": ["title", "problem", "acceptanceCriteria", "estimatedInternalMinutes", "maxBudgetUsdc", "allowExternalDelegation"],
  "properties": {
    "id": {"type": "string"},
    "sourceAgent": {"type": "string"},
    "projectRef": {"type": "string"},
    "title": {"type": "string", "minLength": 5, "maxLength": 140},
    "problem": {"type": "string", "minLength": 10},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "allowedFiles": {"type": "array", "items": {"type": "string"}},
    "estimatedInternalMinutes": {"type": "number", "minimum": 0},
    "maxBudgetUsdc": {"type": "number", "minimum": 0},
    "minimumPayoutUsdc": {"type": "number", "minimum": 0},
    "deadlineHours": {"type": "number", "minimum": 1},
    "allowExternalDelegation": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
